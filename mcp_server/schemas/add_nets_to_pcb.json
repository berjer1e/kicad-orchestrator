{
  "name": "add_nets_to_pcb",
  "description": "Declare electrical nets in a legacy or KiCad 10 inline-net PCB.",
  "parameters": {
    "type": "object",
    "properties": {
      "pcb_path": {"type": "string"},
      "nets": {
        "type": "array",
        "items": {
          "anyOf": [
            {"type": "string"},
            {"type": "object", "additionalProperties": true}
          ]
        }
      },
      "output_path": {
        "anyOf": [{"type": "string"}, {"type": "null"}],
        "default": null
      }
    },
    "required": ["pcb_path", "nets"]
  }
}
