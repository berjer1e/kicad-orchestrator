{
  "name": "assign_pad_nets",
  "description": "Assign net names to PCB pads using footprint references and pad numbers.",
  "parameters": {
    "type": "object",
    "properties": {
      "pcb_path": {"type": "string"},
      "assignments": {
        "type": "array",
        "items": {"type": "object", "additionalProperties": true}
      },
      "output_path": {
        "anyOf": [{"type": "string"}, {"type": "null"}],
        "default": null
      }
    },
    "required": ["pcb_path", "assignments"]
  }
}
